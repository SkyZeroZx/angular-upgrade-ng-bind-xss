{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "projects": {
    "case-4-upgrade-module": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "assets": [
              {
                "glob": "angular.min.js",
                "input": "node_modules/angular",
                "output": "/"
              }
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "patched": {
              "tsConfig": "tsconfig.patched.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4204
          },
          "configurations": {
            "production": {
              "buildTarget": "case-4-upgrade-module:build:production"
            },
            "patched": {
              "buildTarget": "case-4-upgrade-module:build:production,patched",
              "port": 4214
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
